<Window x:Class="SNAPPY.CCTV.DiskCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SNAPPY CCTV Disk Calculator"
        Width="1260" Height="980" MinWidth="1050" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/SNAPPY-icon.png"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="HeaderIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="22,18,22,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="58" Height="48" CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="5" Effect="{DynamicResource SoftShadow}">
                    <Image x:Name="HeaderIconImage" Source="Assets/SNAPPY-icon.png" Stretch="Uniform"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image x:Name="LogoImage" Width="268" Height="37" Stretch="Uniform" HorizontalAlignment="Left"/>
                    <TextBlock Text="CCTV Disk Calculator" FontSize="15" FontWeight="SemiBold" Margin="3,3,0,0" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="DarkThemeButton" Style="{StaticResource ModeButton}" Margin="0,0,8,0" Click="DarkThemeButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="☾" FontSize="17" Margin="0,0,7,0"/><TextBlock Text="Dark" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="LightThemeButton" Style="{StaticResource ModeButton}" Margin="0,0,8,0" Click="LightThemeButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="☼" FontSize="17" Margin="0,0,7,0"/><TextBlock Text="Light" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Style="{StaticResource ModeButton}" Click="ResetButton_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="↻" FontSize="17" Margin="0,0,7,0"/><TextBlock Text="Reset" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="22,0,22,12" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="1"/><ColumnDefinition Width="270"/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Margin="4,0,18,0">
                    <TextBlock Text="SYSTEM MODE" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="NvrButton" Style="{StaticResource GlowButton}" Width="102" Height="34" Margin="0,0,8,0" Click="NvrButton_Click"><TextBlock Text="▣  NVR"/></Button>
                        <Button x:Name="VmsButton" Style="{StaticResource ModeButton}" Width="102" Height="34" Click="VmsButton_Click"><TextBlock Text="▤  VMS"/></Button>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Width="1" Margin="0,4,18,4"/>
                <StackPanel Grid.Column="2" Margin="0,0,18,0">
                    <TextBlock Text="CALCULATION MODE" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CalculationModeBox" SelectionChanged="CalculationModeBox_SelectionChanged">
                        <ComboBoxItem Content="Smart / Recommended"/><ComboBoxItem Content="Manual Bitrate"/>
                    </ComboBox>
                </StackPanel>
                <Border Grid.Column="3" Background="{DynamicResource BorderBrush}" Width="1" Margin="0,4,18,4"/>
                <Grid Grid.Column="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ModeIconText" Text="▣" FontSize="25" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="ModeTitleText" Text="NVR MODE" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                        <TextBlock x:Name="ModeDescriptionText" Text="Storage is calculated for the selected NVR/storage disks." Style="{StaticResource SmallText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="22,0,22,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="◉" Style="{StaticResource HeaderIcon}" Margin="0,0,10,0"/><TextBlock Text="Camera Configuration" Style="{StaticResource SectionTitle}"/></StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Camera Count" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="CameraCountBox" Text="1"/>
                                <TextBlock Grid.Row="1" Text="Encoding" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,10,0,0"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="EncodeBox" Margin="0,10,0,0" SelectionChanged="SmartSetting_SelectionChanged"><ComboBoxItem Content="H.265+"/><ComboBoxItem Content="H.265"/><ComboBoxItem Content="H.264+"/><ComboBoxItem Content="H.264"/></ComboBox>
                                <TextBlock Grid.Row="2" Text="Resolution" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,10,0,0"/><ComboBox Grid.Row="2" Grid.Column="1" x:Name="MpBox" Margin="0,10,0,0" SelectionChanged="SmartSetting_SelectionChanged"/>
                                <TextBlock Grid.Row="3" Text="Frame Rate (FPS)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,10,0,0"/><ComboBox Grid.Row="3" Grid.Column="1" x:Name="FpsBox" Margin="0,10,0,0" SelectionChanged="SmartSetting_SelectionChanged"/>
                                <TextBlock Grid.Row="4" Text="Bitrate Type" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,10,0,0"/><ComboBox Grid.Row="4" Grid.Column="1" x:Name="RateBox" Margin="0,10,0,0" SelectionChanged="SmartSetting_SelectionChanged"><ComboBoxItem Content="CBR"/><ComboBoxItem Content="VBR"/></ComboBox>
                                <TextBlock Grid.Row="5" Text="VBR Level" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,10,0,0"/><ComboBox Grid.Row="5" Grid.Column="1" x:Name="VbrBox" Margin="0,10,0,0" SelectionChanged="SmartSetting_SelectionChanged"/>
                                <TextBlock Grid.Row="6" Text="Scene Complexity" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,10,0,0"/><ComboBox Grid.Row="6" Grid.Column="1" x:Name="SceneComplexityBox" Margin="0,10,0,0" SelectionChanged="SmartSetting_SelectionChanged"/>
                                <TextBlock Grid.Row="7" Text="Smart / Manual Bitrate (Kbps)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,10,0,0"/><TextBox Grid.Row="7" Grid.Column="1" x:Name="BitrateBox" Text="2048" Margin="0,10,0,0"/>
                            </Grid>
                            <TextBlock Text="Smart mode updates this value automatically; Manual mode allows direct bitrate entry." Style="{StaticResource SmallText}" Margin="145,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="▤" Style="{StaticResource HeaderIcon}" Margin="0,0,10,0"/><TextBlock Text="Storage Configuration" Style="{StaticResource SectionTitle}"/></StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Recording Hours / Day" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="HoursBox" Text="24"/>
                                <TextBlock Grid.Row="1" Text="Retention" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,10,0,0"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="RetentionBox" Text="30" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Text="Retention Unit" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,10,0,0"/><ComboBox Grid.Row="2" Grid.Column="1" x:Name="RetentionUnitBox" Margin="0,10,0,0"><ComboBoxItem Content="Days"/><ComboBoxItem Content="Months"/></ComboBox>
                                <TextBlock Grid.Row="3" Text="Disk Size (TB)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,10,0,0"/><ComboBox Grid.Row="3" Grid.Column="1" x:Name="DiskBox" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="4" Text="Storage Overhead (%)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,10,0,0"/><TextBox Grid.Row="4" Grid.Column="1" x:Name="OverheadBox" Text="10" Margin="0,10,0,0"/>
                            </Grid>

                            <Border Margin="0,16,0,0" Padding="12" CornerRadius="10" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Effect="{DynamicResource Glow}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="✦" Foreground="{DynamicResource AccentBrush}" FontSize="18" Margin="0,0,8,0"/><TextBlock Text="Smart Recommended Settings" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14"/></StackPanel>
                                    <Separator Margin="0,8" Background="{DynamicResource BorderBrush}"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Recommended Bitrate" Style="{StaticResource SmallText}"/><TextBlock Grid.Column="1" x:Name="RecommendedBitrateText" Text="2.05 Mbps" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/></Grid>
                                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Estimated Average Bitrate" Style="{StaticResource SmallText}"/><TextBlock Grid.Column="1" x:Name="AverageBitrateText" Text="1.77 Mbps" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/></Grid>
                                    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Storage Bitrate" Style="{StaticResource SmallText}"/><TextBlock Grid.Column="1" x:Name="StorageBitrateText" Text="1.77 Mbps" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/></Grid>
                                    <TextBlock x:Name="SmartStatusText" Text="Smart AI recalculates from resolution, FPS, compression, CBR/VBR, VBR level and scene complexity." Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- VMS ONLY: storage chassis + RAID planning. No server hardware sizing is shown. -->
                            <Border x:Name="VmsStoragePanel" Visibility="Collapsed" Margin="0,14,0,0" Padding="12" CornerRadius="10" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Effect="{DynamicResource Glow}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="▤" Foreground="{DynamicResource AccentBrush}" FontSize="18" Margin="0,0,8,0"/><TextBlock Text="VMS Storage Bay &amp; RAID" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14"/></StackPanel>
                                    <TextBlock Text="These settings are applied to the calculated storage requirement after CALCULATE STORAGE." Style="{StaticResource SmallText}" TextWrapping="Wrap" Margin="0,5,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="105"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Storage Bay Type" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="BayTypeBox" SelectionChanged="VmsStorageSetting_Changed"><ComboBoxItem Content="4-Bay"/><ComboBoxItem Content="8-Bay"/><ComboBoxItem Content="16-Bay"/><ComboBoxItem Content="24-Bay"/></ComboBox>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="RAID System" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <ComboBox Grid.Row="0" Grid.Column="3" x:Name="RaidTypeBox" SelectionChanged="VmsStorageSetting_Changed"><ComboBoxItem Content="RAID 6"/><ComboBoxItem Content="RAID 5"/><ComboBoxItem Content="RAID 10"/><ComboBoxItem Content="RAID 1"/></ComboBox>
                                        <TextBlock Grid.Row="1" Text="Required Usable" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="VmsRequiredUsableText" Text="— TB" Style="{StaticResource ValueText}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="RAID Status" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="VmsRaidStatusText" Text="Calculate storage first" Style="{StaticResource ValueText}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="2" Text="Bay Capacity" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="VmsBayCapacityText" Text="—" Style="{StaticResource ValueText}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="RAID Groups" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="3" x:Name="RaidGroupBox" Text="1" TextChanged="VmsManualSetting_Changed" ToolTip="Number of separate RAID groups. This is manually adjustable."/>
                                        <TextBlock Grid.Row="3" Text="Hot Spare Disks" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="HotSpareBox" Text="0" TextChanged="VmsManualSetting_Changed" ToolTip="Additional physical disks reserved as hot spares. They do not add usable RAID capacity."/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Data Disks / Group" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock Grid.Row="3" Grid.Column="3" x:Name="VmsDataDisksPerGroupText" Text="—" Style="{StaticResource ValueText}"/>
                                        <TextBlock Grid.Row="4" Text="Total Installed Disks" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="VmsTotalDiskCountText" Text="—" Style="{StaticResource ValueText}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Free Bays" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        <TextBlock Grid.Row="5" Text="Required Data Disks" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="VmsDiskCountText" Text="—" Style="{StaticResource ValueText}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="3" x:Name="VmsFreeBaysText" Text="—" Style="{StaticResource ValueText}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Button x:Name="CalculateButton" Style="{StaticResource GlowButton}" Height="48" Margin="0,0,0,10" Click="CalculateButton_Click">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="22" Margin="0,0,10,0"/><TextBlock Text="CALCULATE STORAGE" FontSize="14" VerticalAlignment="Center"/><TextBlock Text="  »" FontSize="20" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
                </Button>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="◉" Style="{StaticResource HeaderIcon}" Margin="0,0,10,0"/><TextBlock Text="REQUIRED STORAGE" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/></StackPanel>
                            <TextBlock x:Name="RequiredTbText" Text="— TB" Style="{StaticResource MetricValue}" Margin="0,8,0,0"/>
                            <TextBlock x:Name="RequiredGbText" Text="— GB" Style="{StaticResource SmallText}" Margin="0,0,0,10"/>
                            <Separator Background="{DynamicResource BorderBrush}"/>
                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Per Camera / Day" Style="{StaticResource SmallText}"/><TextBlock Grid.Column="1" x:Name="PerCameraText" Style="{StaticResource ValueText}"/></Grid>
                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="All Cameras / Day" Style="{StaticResource SmallText}"/><TextBlock Grid.Column="1" x:Name="AllCamerasText" Style="{StaticResource ValueText}"/></Grid>
                            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Base Disk Count" Style="{StaticResource SmallText}"/><TextBlock Grid.Column="1" x:Name="DiskCountText" Style="{StaticResource ValueText}"/></Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⌘" Style="{StaticResource HeaderIcon}" Margin="0,0,10,0"/><TextBlock Text="STORAGE DETAILS" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/></StackPanel>
                            <TextBlock x:Name="ArchitectureText" Text="NVR Mode: calculate storage to see disk details." Style="{StaticResource ValueText}" Margin="0,9,0,8" TextWrapping="Wrap"/>
                            <Separator Background="{DynamicResource BorderBrush}"/>
                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Summary" Style="{StaticResource SmallText}"/><TextBlock Grid.Column="1" x:Name="SummaryText" Style="{StaticResource SmallText}" TextWrapping="Wrap" TextAlignment="Right"/></Grid>
                            <TextBlock Text="RAID / Bay Details" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,10,0,3"/>
                            <TextBlock x:Name="VmsRaidDetailsText" Text="VMS mode: RAID details will appear after calculation." Style="{StaticResource SmallText}" TextWrapping="Wrap"/>
                            <TextBlock Text="Calculation Note" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" Margin="0,10,0,3"/>
                            <TextBlock x:Name="CalculationNoteText" Style="{StaticResource SmallText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Margin="22,8,22,14" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="9,6">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Ellipse Width="12" Height="12" Fill="#36D56B" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Ready - press CALCULATE STORAGE" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="◉" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0"/><TextBlock Text="SNAPPY CCTV Disk Calculator" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/></StackPanel></Grid>
        </Border>
    </Grid>
</Window>
