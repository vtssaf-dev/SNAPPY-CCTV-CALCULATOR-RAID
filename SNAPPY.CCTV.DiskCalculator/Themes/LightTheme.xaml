<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WindowColor">#F4F9FF</Color><Color x:Key="CardColor">#FFFFFF</Color><Color x:Key="InputColor">#FFFFFF</Color><Color x:Key="BorderColor">#B9D6F2</Color><Color x:Key="TextColor">#0A2448</Color><Color x:Key="MutedColor">#45617D</Color><Color x:Key="AccentColor">#087FF5</Color><Color x:Key="Accent2Color">#075BC7</Color>
  <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/><SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/><SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}"/><SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/><SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/><SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/><SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/><SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}"/>
  <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#EEF7FF" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="InputGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#F3F9FF" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0A91FF" Offset="0"/><GradientStop Color="#0872E7" Offset="0.55"/><GradientStop Color="#16B8FF" Offset="1"/></LinearGradientBrush>
  <DropShadowEffect x:Key="Glow" BlurRadius="18" ShadowDepth="0" Color="#0B9EFF" Opacity="0.35"/><DropShadowEffect x:Key="SoftShadow" BlurRadius="18" ShadowDepth="3" Color="#7092B5" Opacity="0.22"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style><Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style><Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource WindowBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#0A2448"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,7"/><Setter Property="FontSize" Value="13"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#0B9DFF"/><Setter TargetName="Box" Property="Effect" Value="{StaticResource Glow}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#0A2448"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Height" Value="36"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="ItemContainerStyle" Value="{DynamicResource LightComboItem}"/></Style>
  <Style x:Key="LightComboItem" TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#0A2448"/><Setter Property="Background" Value="#FFFFFF"/><Setter Property="Padding" Value="10,8"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#DCEEFF"/><Setter Property="Foreground" Value="#062B5E"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#BFE4FF"/><Setter Property="Foreground" Value="#062B5E"/></Trigger></Style.Triggers></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardGradient}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14"/><Setter Property="Effect" Value="{StaticResource SoftShadow}"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style><Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/></Style><Style x:Key="SmallText" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="11"/></Style>
  <Style x:Key="GlowButton" TargetType="Button"><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="Background" Value="{DynamicResource AccentGradient}"/><Setter Property="BorderBrush" Value="#59C8FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="18,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"><Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#0B9DFF" Opacity="0.25"/></Border.Effect><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Effect" Value="{StaticResource Glow}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ModeButton" BasedOn="{StaticResource GlowButton}" TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="FontSize" Value="12"/><Setter Property="Background" Value="#E9F5FF"/><Setter Property="Foreground" Value="#0A2448"/><Setter Property="BorderBrush" Value="#A8D1F3"/></Style>
  <Style x:Key="MetricValue" TargetType="TextBlock"><Setter Property="Foreground" Value="#0877E8"/><Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="Bold"/></Style>
</ResourceDictionary>
