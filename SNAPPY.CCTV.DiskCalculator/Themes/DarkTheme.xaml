<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="WindowColor">#06101F</Color>
  <Color x:Key="CardColor">#0B1930</Color>
  <Color x:Key="InputColor">#0A2342</Color>
  <Color x:Key="BorderColor">#1767A8</Color>
  <Color x:Key="TextColor">#FFFFFF</Color>
  <Color x:Key="MutedColor">#C5D6E8</Color>
  <Color x:Key="AccentColor">#13A8FF</Color>
  <Color x:Key="Accent2Color">#0068FF</Color>
  <Color x:Key="GlowColor">#18B7FF</Color>

  <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/>
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
  <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}"/>
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#C5D6E8"/>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}"/>

  <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#102747" Offset="0"/>
    <GradientStop Color="#071426" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="InputGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#10325A" Offset="0"/>
    <GradientStop Color="#081B35" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#009BFF" Offset="0"/>
    <GradientStop Color="#0066FF" Offset="0.55"/>
    <GradientStop Color="#14C8FF" Offset="1"/>
  </LinearGradientBrush>

  <DropShadowEffect x:Key="Glow" BlurRadius="18" ShadowDepth="0" Color="#149DFF" Opacity="0.55"/>
  <DropShadowEffect x:Key="SoftShadow" BlurRadius="18" ShadowDepth="4" Color="#000000" Opacity="0.45"/>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
  </Style>
  <Style TargetType="Label">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
  </Style>
  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>

  <!-- Explicit white text/caret/selection for all dark-mode TextBoxes -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CaretBrush" Value="#FFFFFF"/>
    <Setter Property="SelectionBrush" Value="#168FE8"/>
    <Setter Property="SelectionTextBrush" Value="#FFFFFF"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Box"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8">
            <Border.Effect>
              <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#006CFF" Opacity="0.10"/>
            </Border.Effect>
            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="#24B8FF"/>
              <Setter TargetName="Box" Property="Effect" Value="{StaticResource Glow}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dark ComboBox: white selected value and white popup items -->
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="ItemContainerStyle" Value="{DynamicResource DarkComboItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="ComboBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <Grid>
                <ContentPresenter x:Name="ContentSite"
                                  Margin="12,0,34,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                  TextElement.Foreground="#FFFFFF"
                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                  TextElement.FontFamily="Segoe UI"/>
                <Path Data="M 0 0 L 5 5 L 10 0 Z"
                      Fill="#FFFFFF"
                      Width="10"
                      Height="6"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"/>
              </Grid>
            </Border>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   PopupAnimation="Slide"
                   Focusable="False">
              <Border Background="#0B1930"
                      BorderBrush="#1767A8"
                      BorderThickness="1"
                      CornerRadius="8"
                      Margin="0,4,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer MaxHeight="320">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#24B8FF"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#24B8FF"/>
              <Setter TargetName="ComboBorder" Property="Effect" Value="{StaticResource Glow}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ComboBorder" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="Background" Value="#0B1930"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="ItemBorder"
                  Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              TextElement.Foreground="#FFFFFF"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="#1268A8"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemBorder" Property="Background" Value="#0D8FEA"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="14"/>
    <Setter Property="Effect" Value="{StaticResource SoftShadow}"/>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#C5D6E8"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="SmallText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#C5D6E8"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style x:Key="GlowButton" TargetType="Button">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
    <Setter Property="BorderBrush" Value="#35C6FF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="18,10"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
            <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#00A8FF" Opacity="0.42"/></Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#FFFFFF"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Effect" Value="{StaticResource Glow}"/>
              <Setter TargetName="B" Property="Opacity" Value="1"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.82"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/><Setter Property="Foreground" Value="#7E8EA2"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ModeButton" BasedOn="{StaticResource GlowButton}" TargetType="Button">
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Background" Value="#0D2949"/>
    <Setter Property="BorderBrush" Value="#1D6096"/>
  </Style>
  <Style x:Key="MetricValue" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#2EC0FF"/>
    <Setter Property="FontSize" Value="27"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
</ResourceDictionary>
